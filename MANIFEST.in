include SKILL.md AGENTS.md CLAUDE.md README.md README.en.md LICENSE SECURITY.md CONTRIBUTING.md .gitignore
recursive-include bma *.py
recursive-include scripts *.py
recursive-include tests *.py
recursive-include skills *.md
recursive-include docs *.md
recursive-include docs/assets *.svg
recursive-include knowledge *.md
recursive-include workflows *.md
recursive-include validators *.md
recursive-include integrations *.md
recursive-include examples *.py *.md *.json
recursive-include .github *.yml
prune outputs
prune private
prune .cache
prune .venv
global-exclude *.pyc *.pyo
